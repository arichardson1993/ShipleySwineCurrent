@model  ShipleySwine.ViewModels.BredGiltsIndexViewModel
@{
    ViewBag.Title = "Shipley Swine Genetics | Bred Gilts";
    ViewBag.MetaDescription = "Browse bred gilts from Shipley Swine Genetics and contact us to preorder.";

}

<div @*style="background-color: #f8f9fa;"*@ class="container pb-5 pt-5 mb-5 backgroundcolor">
    <div style="background-color: #f8f9fa;" class="p-3">

        <div class="row text-center">
            <div class="col-12">
                <div class="sellingpointscolor shadow rounded pb-3 pt-3 font-weight-bold">
                    <h1>Call Today to Preorder your Shipley Bred Gilts the way you want!</h1>
                    <h3>
                        <span class="mr-2 phonetextsize text-black-50" style="font-weight:bold; text-decoration:underline;">
                            <i class="fa fa-phone mr-2"></i>
                            1-866-376-8986
                        </span>
                        <span class="phonetextsize">
                            (Toll Free) •
                        </span>
                        <span class="phonetextsize text-black-50" style=" font-weight:bold; text-decoration:underline; ">
                            <i class="fa fa-phone mr-2 ml-2"></i>740-745-2911
                        </span>
                    </h3>
                </div>
            </div>
        </div>
        <div class="row text-center mt-4">
            <div class="col-12">
                <h1><span style="font-weight: bold;">YOU choose the:</span></h1>
            </div>
        </div>
        <div class="row text-center m-auto">
            <div class="col-3 m-auto columncolor">
                <div class="w-100 h-100 m-auto shadow rounded sellingpointscolor">
                    <div class="sellingpoints">
                        Price
                    </div>
                </div>
            </div>
            <div class="col-3 columncolor">
                <div class="w-100 h-100 m-auto shadow rounded sellingpointscolor">
                    <div class="sellingpoints">
                        Breed
                    </div>
                </div>
            </div>
            <div class="col-3 columncolor">
                <div class="w-100 h-100 m-auto shadow rounded sellingpointscolor">
                    <div class="sellingpoints">
                        Mating
                    </div>
                </div>
            </div>
            <div class="col-3 columncolor">
                <div class="w-100 h-100 m-auto shadow rounded sellingpointscolor">
                    <div class="sellingpoints">
                        Date
                    </div>
                </div>
            </div>
        </div>
    </div>


@*<div class="container">*@

    <section id="tabs">
	    <div class="container">
		    <h6 class="section-title h1 text-center mb-5">How is Pricing Determined?</h6>
		    <div class="row">
			    <div class="col-xs-15 ">
				    <nav>
                        <div class="nav nav-tabs nav-fill text-black-50" id="nav-tab" role="tablist">
                            @*<a class="nav-item nav-link text-black-50 backgroundcolor rounded" id="nav-about-tab" data-toggle="tab" href="#nav-about" role="tab" aria-controls="nav-about" aria-selected="false"><i style="color:#d9d926;" class="fa fa-star"></i> $2500+</a>*@
                            <a class="nav-item nav-link active text-black-50 backgroundcolor rounded smallscreengiltnav" id="nav-about-tab" data-toggle="tab" href="#nav-about" role="tab" aria-controls="nav-about" aria-selected="false"><i style="color:#ffd800" class="fa fa-star"></i> $2500+ (Shipley super-elite keepers)</a>
                            <a class="nav-item nav-link text-black-50 backgroundcolor rounded smallscreengiltnav" id="nav-contact-tab" data-toggle="tab" href="#nav-contact" role="tab" aria-controls="nav-contact" aria-selected="false">$1950 (Shipley elite keepers)</a>
                            <a class="nav-item nav-link text-black-50 backgroundcolor rounded smallscreengiltnav" id="nav-contact-tab" data-toggle="tab" href="#nav-contact" role="tab" aria-controls="nav-contact" aria-selected="false">$1550 (Shipley keepers)</a>
                            <a class="nav-item nav-link text-black-50 backgroundcolor rounded smallscreengiltnav" id="nav-profile-tab" data-toggle="tab" href="#nav-profile" role="tab" aria-controls="nav-profile" aria-selected="false">$1050</a>
                        </div>
				    </nav>
                    <p style="font-weight: bold;">*All bred gilts are guaranteed to farrow at least eight pigs.</p>
				    <div class="tab-content py-3 px-3 px-sm-0" id="nav-tabContent">
					    <div style="color: black;" class="tab-pane fade" id="nav-profile" role="tabpanel" aria-labelledby="nav-profile-tab">
                            <h2 class="text-center">Keeper Gilts</h2>
                            <p class="text-center">These gilts are good enough to stay here and join the sow herd. (Very nice gilts - sounder, thicker and more muscle - they look the part)</p>
					    </div>
					    <div style="color: black;" class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="nav-contact-tab">
                            <h2 class="text-center">Elite Keeper</h2>
                            <p class="text-center">The very top end gilts out of some of our very top end sows</p>
					    </div>
					    <div style="color: black;" class="tab-pane fade active show" id="nav-about" role="tabpanel" aria-labelledby="nav-about-tab">
                            <h2 class="text-center">Super Elite Keeper</h2>
                            <p class="text-center">Like the Elite Keepers they are very superior in their design but are also out of sows that are <i>very elite</i> in our herd (Sows that Generate). We get asked the question "Can we buy what you are keeping?" Now that we have our sow herd in good shape we can share a few of these gilts. We do not want to sell very many of these girls. From time to time we will list a few of these gilts for sale. In some cases they are <i>better</i> than the elite keepers and they are always out of sows that generate litter after litter. <i>The Best of The Best</i></p>
					    </div>
				    </div>
			
			    </div>
		    </div>
	    </div>
    </section>
    <!-- ./Tabs -->


    <section class="bred-gilt-list mt-4" aria-labelledby="available-bred-gilts">
        <header class="bred-gilt-list-header">
            <h2 id="available-bred-gilts">Available Bred Gilts</h2>
            <p>Listed by expected farrowing date.</p>
        </header>

        @if (Model.Gilts.Count == 0)
        {
            <p>No bred gilts are currently listed.</p>
        }
        else
        {
            foreach (var gilt in Model.Gilts)
            {
                var serviceSireId = Model.FindBoarId(gilt.SvcSire);
                var sireId = Model.FindBoarId(gilt.Sire);
                var sireOfDamId = Model.FindBoarId(gilt.SireOfDam);
                <article class="bred-gilt-card">
                    <div class="bred-gilt-heading">
                        <div>
                            <h3>@gilt.Breed</h3>
                            <span class="bred-gilt-ear-notch">Ear notch @gilt.EarNotch</span>
                        </div>
                        <strong class="bred-gilt-price">@(gilt.Price.HasValue ? gilt.Price.Value.ToString("C0") : "Call for price")</strong>
                    </div>
                    <p class="bred-gilt-mating">
                        Bred to
                        @if (serviceSireId.HasValue)
                        {
                            <a class="bred-gilt-boar-link" href="@Url.Action("Details", "Boars", new { id = serviceSireId.Value })">@gilt.SvcSire</a>
                        }
                        else
                        {
                            <strong>@gilt.SvcSire</strong>
                        }
                        <span class="bred-gilt-separator">·</span>Due <strong>@(gilt.DueDate.HasValue ? gilt.DueDate.Value.ToString("MMM d, yyyy") : "date available on request")</strong>
                    </p>
                    <p class="bred-gilt-pedigree">
                        Sired by
                        @if (sireId.HasValue)
                        {
                            <a class="bred-gilt-boar-link" href="@Url.Action("Details", "Boars", new { id = sireId.Value })">@gilt.Sire</a>
                        }
                        else
                        {
                            @gilt.Sire
                        }
                        <span class="bred-gilt-separator">·</span>Dam EN @gilt.DamEN by
                        @if (sireOfDamId.HasValue)
                        {
                            <a class="bred-gilt-boar-link" href="@Url.Action("Details", "Boars", new { id = sireOfDamId.Value })">@gilt.SireOfDam</a>
                        }
                        else
                        {
                            @gilt.SireOfDam
                        }
                    </p>
                    <p class="bred-gilt-meta">Bred @(gilt.DateBred.HasValue ? gilt.DateBred.Value.ToString("MMM d, yyyy") : "date available on request")<span class="bred-gilt-separator">·</span>Farrowed @(gilt.DOB.HasValue ? gilt.DOB.Value.ToString("MMM d, yyyy") : "date available on request")<span class="bred-gilt-separator">·</span>Litter of @gilt.LitterSize</p>
                    <a class="bred-gilt-interest" href="@Url.Action("Email", "BredGilts", new { number = gilt.BredGuiltId })">I'm Interested</a>
                </article>
            }
        }
    </section>
</div>
